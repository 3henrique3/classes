# Menu de celular


def celularMenu():
    
    while True:
        print("\nMENU -")
        print("1 - Ligar celular")
        print("2 - Ativar modo avião")
        print("3 - Desativar modo avião")
        print("4 - Ativar Wi-Fi")
        print("5 - Desativar Wi-Fi")
        print("6 - Fazer ligação")
        print("7 - Encerrar ligação")
        print("8 - Sair")

        opcaoMenu = input("Escolha uma opção: ")

        def ligar():
            print("\nLigando celular")

        def ativar_modoAviao():
            print("\nAtivando modo avião.")

        def desativar_modo_aviao():
            print("\nDesativando modo avião.")

        def ativar_wifi():
            print("\nAtivando wifi")

        def desativar_wifi():
            print("\nDesativando wifi")

        def desativar_wifi():
            print("\nAtivando wifi")

        def ligar_contato():
            contato = input("\nDigite o nome do contato: ")
            print("\nLigando para", contato)

        def encerrar_ligacao():
            print("\nChamada encerrada.")


        if opcaoMenu == "1":
            ligar()
        elif opcaoMenu == "2":
            ativar_modoAviao()
        elif opcaoMenu == "3":
            desativar_modo_aviao()
        elif opcaoMenu == "4":
            ativar_wifi()
        elif opcaoMenu == "5":
            desativar_wifi()
        elif opcaoMenu == "6":
            ligar_contato()
        elif opcaoMenu == "7":
            encerrar_ligacao()
        elif opcaoMenu == "8":
            print("\nDesligando celular.")
            break
        else:
            print("Opção inválida")

celularMenu()
